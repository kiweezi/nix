// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "main",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:bookworm",

	"features": {
		"ghcr.io/devcontainers/features/nix:1": {
			// Enable the usual experimental features for nix, which should definately be enabled by default.
			"extraNixConfig": "experimental-features = nix-command flakes\n"
		},
		"ghcr.io/guiyomh/features/just:0": {},
		"ghcr.io/devcontainers/features/powershell:2.0.1": {}
	},

	"customizations": {
		"vscode": {
			"settings": {
				// Helps with some annoying warnings in vscode-icons.
				"workbench.iconTheme": "vscode-icons",
				"vsicons.dontShowNewVersionMessage": true
			},
			"extensions": [
				"nefrob.vscode-just-syntax",
				"vscode-icons-team.vscode-icons",
				"bbenoist.nix"
			]
		}
	}

	// // Install fonts before the first use of the container.
	// "onCreateCommand": {}
}